# Copy this file to .env and fill it in. Never commit .env.

# --- Models ---------------------------------------------------------------
# Needed for embeddings (duplicate check and department lookup), and for the
# classifier and letters when FAKE_LLM is 0.
GOOGLE_API_KEY=paste-your-gemini-key-here
# 1 = rule-based classifier and template letter (no generation quota used)
FAKE_LLM=1
# 1 = local hashed embeddings instead of Gemini (no key or network; crude)
FAKE_EMBEDDINGS=0

# --- Django ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Follow-up scheduler --------------------------------------------------
# Seconds between follow-up checks
FOLLOWUP_INTERVAL=300

# --- Email (reminders, escalations, "resolved" notices) -------------------
# Default prints emails in the backend log. For real mail use the SMTP backend:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=CivicSense <alerts@your-domain.example>
